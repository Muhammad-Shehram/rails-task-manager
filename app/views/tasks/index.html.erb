<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">My Tasks</h1>
    <%= link_to new_task_path, class: "btn btn-premium" do %>
      <i class="fas fa-plus me-2"></i> Add Task
    <% end %>
  </div>

  <% @tasks.each do |task| %>
    <div class="task-card p-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <% if task.completed %>
          <i class="fa-regular fa-square-check task-icon text-success"></i>
        <% else %>
          <i class="fa-regular fa-square task-icon text-muted"></i>
        <% end %>

        <%= link_to task.title, task_path(task),
            class: "text-decoration-none fw-medium #{'completed-text' if task.completed}" %>
      </div>

      <%= link_to task_path(task), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-danger opacity-50" do %>
        <i class="fas fa-trash-can"></i>
      <% end %>
    </div>
  <% end %>
</div>
