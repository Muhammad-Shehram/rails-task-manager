<div class="container">
  <div class="task-card p-5">
    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <%# Status Badge %>
        <% if @task.completed %>
          <span class="badge rounded-pill bg-success-subtle text-success mb-2 p-2 px-3">
            <i class="fa-solid fa-circle-check me-1"></i> Completed
          </span>
        <% else %>
          <span class="badge rounded-pill bg-warning-subtle text-warning mb-2 p-2 px-3">
            <i class="fa-solid fa-clock me-1"></i> Pending
          </span>
        <% end %>

        <h1 class="fw-bold display-5 mt-2"><%= @task.title %></h1>
      </div>

      <div class="d-flex gap-2">
        <%= link_to edit_task_path(@task), class: "btn btn-outline-secondary btn-sm rounded-pill" do %>
          <i class="fa-solid fa-pen-to-square"></i> Edit
        <% end %>
      </div>
    </div>

    <div class="task-details mb-5">
      <p class="lead text-muted" style="white-space: pre-wrap;"><%= @task.details.presence || "No additional details provided." %></p>
    </div>

    <hr class="opacity-10 mb-4">

    <div class="d-flex justify-content-between align-items-center">
      <%= link_to tasks_path, class: "text-decoration-none text-muted fw-medium" do %>
        <i class="fa-solid fa-arrow-left-long me-2"></i> Back to My Tasks
      <% end %>

      <%= link_to task_path(@task),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this task?" },
          class: "btn btn-link text-danger text-decoration-none" do %>
        <i class="fa-solid fa-trash-can me-2"></i> Delete Task
      <% end %>
    </div>
  </div>
</div>
