<%= form_with model: @task, class: "task-card p-4" do |f| %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label fw-bold" %>
    <%= f.text_field :title, class: "form-control", placeholder: "What needs to be done?" %>
  </div>

  <div class="mb-3">
    <%= f.label :details, class: "form-label fw-bold" %>
    <%= f.text_area :details, class: "form-control", rows: 3, placeholder: "Add some notes..." %>
  </div>

  <% if @task.persisted? %>
    <div class="mb-3 form-check">
      <%= f.check_box :completed, class: "form-check-input" %>
      <%= f.label :completed, "Mark as finished", class: "form-check-label" %>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-premium" %>
    <%= link_to "Cancel", tasks_path, class: "btn btn-light" %>
  </div>
<% end %>
